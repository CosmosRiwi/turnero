@{
    Layout = "_Layout";
    ViewData["Title"] = "Ingreso al Sistema";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=Lato:wght@300;400;700&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true"/>
}
<div class="container-fluid px-0">
    <div class="row justify-content-center align-items-center" style="min-height: 100vh; background: linear-gradient(135deg, #0a1628 0%, #112244 60%, #1a3060 100%);">
        <div class="col-md-5 col-lg-4 px-4">
            <div class="login-card">
                <div class="card-header text-center">
                    <div class="logo-ring">
                        <i class="fas fa-ticket-alt"></i>
                    </div>
                    <h3>Sistema de Turnos</h3>
                    <small>Panel de Gestión Administrativa</small>
                </div>

                <div class="card-body p-4">
                    <div id="login-form">
                        <div class="mb-4">
                            <label class="field-label mb-2 d-block">Usuario</label>
                            <div class="input-group login-input-group">
                                <span class="input-group-text"><i class="fas fa-user fa-sm"></i></span>
                                <input type="text" id="username" class="form-control"
                                       placeholder="Ej: jose_asesor" autofocus>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="field-label mb-2 d-block">Contraseña</label>
                            <div class="input-group login-input-group">
                                <span class="input-group-text"><i class="fas fa-key fa-sm"></i></span>
                                <input type="password" id="password" class="form-control"
                                       placeholder="••••••••">
                            </div>
                        </div>

                        <div class="d-grid mt-4">
                            <button class="btn btn-gold btn-lg" onclick="iniciarSesion()">
                                <i class="fas fa-arrow-right me-2"></i> Ingresar al Panel
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card-footer text-center">
                    <p>Gestión de Turnos &copy; 2026 — Riwi Academy</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Aplica el fondo oscuro al body solo en esta página
        document.body.classList.add('login-page');

        function iniciarSesion() {
            const usuario = $("#username").val();
            const clave = $("#password").val();

            if (!usuario || !clave) {
                Swal.fire('Atención', 'Por favor completa todos los campos', 'warning');
                return;
            }

            Swal.showLoading();

            $.post('/Account/Login', { username: usuario, password: clave }, function (res) {
                if (res.success) {
                    Swal.fire({
                        title: '¡Bienvenido!',
                        text: 'Redireccionando al panel...',
                        icon: 'success',
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => {
                        window.location.href = res.redirectUrl;
                    });
                } else {
                    Swal.fire({
                        title: 'Error de Acceso',
                        text: res.message,
                        icon: 'error',
                        confirmButtonColor: '#c4a050'
                    });
                }
            }).fail(function () {
                Swal.fire('Error', 'No se pudo conectar con el servidor', 'error');
            });
        }

        $("#password").keypress(function (e) {
            if (e.which === 13) iniciarSesion();
        });
    </script>
}