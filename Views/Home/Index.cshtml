@{
    ViewData["Title"] = "Bienvenido - Solicite su Turno";
    ViewData["FullWidth"] = true;
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=Lato:wght@300;400;700&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true"/>
}

<div class="home-wrapper d-flex align-items-center justify-content-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card home-card text-center">

                    <div class="home-icon-ring mx-auto mb-4">
                        <i class="fas fa-ticket-alt"></i>
                    </div>

                    <h1 class="home-title">Sistema de Turnos</h1>
                    <p class="home-subtitle">Ingrese su documento para obtener un ticket de atención</p>

                    <div class="mb-4">
                        <input type="text"
                               id="dni-cliente"
                               class="form-control form-control-lg text-center home-input"
                               placeholder="Escriba su DNI aquí"
                               autofocus>
                    </div>

                    <div class="d-grid mb-4">
                        <button class="btn btn-lg home-btn-ticket" onclick="solicitarTurno()">
                            <i class="fas fa-ticket-alt me-2"></i>Obtener Turno
                        </button>
                    </div>

                    <a asp-controller="Account" asp-action="Login" class="home-link-admin">
                        <i class="fas fa-lock me-1"></i>Acceso Personal
                    </a>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/home.js"></script>
}