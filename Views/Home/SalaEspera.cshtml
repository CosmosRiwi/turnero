@model SistemaTurnos.Models.Turn
@{
    Layout = "_Layout";
    ViewData["Title"] = "Sala de Espera";
    ViewData["FullWidth"] = true;
    var siguientes = ViewBag.Siguientes as IEnumerable<SistemaTurnos.Models.Turn>;
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="~/css/sala-espera.css" asp-append-version="true"/>
}

<div class="sala-wrapper">
    <div class="container-fluid h-100 p-0">
        <div class="row g-0 h-100">

            <div class="col-md-8 d-flex flex-column align-items-center justify-content-center sala-left">

                <p class="sala-label-actual">
                    <span class="sala-dot-pulse me-2"></span>TURNO ACTUAL
                </p>

                @if (Model != null)
                {
                    <div class="sala-ticket-num" id="txt-sala-ticket">@Model.Ticket</div>
                    <div class="sala-ticket-name">@Model.User.Name @Model.User.LastName</div>
                    <span class="badge sala-badge-atencion mt-3">
                        <i class="fas fa-circle fa-xs me-1"></i>En atención
                    </span>
                }
                else
                {
                    <div class="sala-ticket-num sala-ticket-vacio">---</div>
                    <div class="sala-ticket-name sala-text-muted">ESPERANDO...</div>
                }

            </div>

            <div class="col-md-4 d-flex flex-column sala-right">

                <div class="sala-right-header">
                    <i class="fas fa-list-ol me-2"></i>PRÓXIMOS
                </div>

                <div class="sala-queue flex-grow-1" id="lista-sala-espera">
                    @if (siguientes != null && siguientes.Any())
                    {
                        foreach (var item in siguientes)
                        {
                            <div class="sala-queue-item">
                                <span class="sala-q-ticket">@item.Ticket</span>
                                <span class="sala-q-hora">@(item.CreatedAt?.ToString("HH:mm") ?? "--:--")</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="sala-queue-empty">
                            <i class="fas fa-check-circle mb-2"></i>
                            <p>Sin turnos en espera</p>
                        </div>
                    }
                </div>

                <div class="sala-right-footer">
                    <i class="fas fa-clock me-1"></i>
                    <span id="sala-reloj"></span>
                </div>

            </div>

        </div>
    </div>
</div>

<audio id="audio-notificacion" src="~/fifo.mp3"></audio>

@section Scripts {
    <script src="~/js/home.js"></script>
    <script>
        // Reloj en tiempo real
        function actualizarReloj() {
            const now = new Date();
            document.getElementById('sala-reloj').textContent =
                now.toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        }
        actualizarReloj();
        setInterval(actualizarReloj, 1000);

        // Polling de cambios — funcionalidad original intacta
        let ultimoTicket = "@(Model?.Ticket ?? "")";

        function refrescarSala() {
            $.get('/Home/GetSalaData', function (data) {
                if (data.success && data.ticket !== ultimoTicket) {
                    document.getElementById('audio-notificacion').play();
                    ultimoTicket = data.ticket;
                    setTimeout(() => { location.reload(); }, 1500);
                }
            });
        }

        setInterval(refrescarSala, 5000);
    </script>
}